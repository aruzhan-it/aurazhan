{
  "expo": {
    "name": "Closed Circle",
    "slug": "closed-circle",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.closedcircle.app"
    },
    "android": {
      "package": "com.closedcircle.app",
      "adaptiveIcon": {
        "backgroundColor": "#141518"
      },
      "permissions": [
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {}
  }
}